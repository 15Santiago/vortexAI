# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.

APP_ENV=development
# URL base de tu backend FastAPI (el que ya existe). En Azure: https://TU-BACKEND.azurewebsites.net
BACKEND_URL=http://localhost:8000

# Clave de API de Retell (la marcada como "Webhook"). Es secreta.
RETELL_API_KEY=
RETELL_AGENT_ID=agent_3639aa25c2766e01bf9bfb654d

# Código que debe escribir quien quiera iniciar una llamada (evita que otros gasten tu crédito).
ACCESS_CODE=

# Solo para pruebas locales con curl. Se ignora si APP_ENV=production.
DEV_SKIP_SIGNATURE=false

# Cada cuántos segundos se vuelve a descargar el catálogo del backend.
CATALOG_TTL_SECONDS=600
# Máximo de llamadas web que se pueden crear por hora (tope global de gasto).
MAX_CALLS_PER_HOUR=30

# Opcional: avisos al terminar cada llamada (automatización). Déjalos vacíos para desactivarlos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: orígenes que pueden llamar a /api/crear-llamada desde otro sitio (separados por coma).
CORS_ORIGINS=
